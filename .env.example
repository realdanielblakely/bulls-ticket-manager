# Discord
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_USER_ID=your_numeric_discord_user_id

# Seat pair 1 (lower bowl)
SEAT1_SECTION=101
SEAT1_ROW=A
SEAT1_FROM=1
SEAT1_TO=2
SEAT1_FACE_VALUE=25
SEAT1_LIST_PRICE=35

# Seat pair 2 (upper bowl)
SEAT2_SECTION=201
SEAT2_ROW=B
SEAT2_FROM=1
SEAT2_TO=2
SEAT2_FACE_VALUE=25
SEAT2_LIST_PRICE=35

# Pricing
WEEKEND_PREMIUM=5

# Ticketmaster Account Manager — the Bulls' team portal (NOT ticketmaster.com).
# Per-game links are {base}/{event_id}; save each game's id with `link 6/30 1459`.
TICKETMASTER_BASE_URL=https://am.ticketmaster.com/durhambulls/my-events

# App
DATABASE_PATH=bulls.db
SCHEDULE_CSV_PATH=schedule.csv

# Dashboard
DASHBOARD_PORT=8080
